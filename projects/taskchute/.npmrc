# Supply-chain mitigation: ignore versions published within the last 7 days.
minimum-release-age=10080

# Fail audits on moderate or higher severity.
audit-level=moderate

# Enforce engines field declared in package.json.
engine-strict=true

# Surface unmet peer dependencies instead of silently ignoring them.
strict-peer-dependencies=true

# Suppress funding messages on every install.
fund=false
